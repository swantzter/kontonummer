{
  "name": "kontonummer",
  "version": "5.1.0",
  "description": "A validator for swedish banking numbers",
  "author": "Svante Bengtson <svante@swantzter.se> (https://swantzter.se)",
  "license": "MIT",
  "homepage": "https://kontonummer.se",
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "require": {
      "types": "./dist/cjs/index.d.ts",
      "default": "./dist/cjs/index.js"
    },
    "default": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swantzter/kontonummer.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "build:watch": "tsc --watch -p tsconfig.production.json",
    "test": "NODE_OPTIONS='--import tsx' mocha test/**/*.test.ts",
    "test:coverage": " c8 -r lcov -r text npm test",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.35",
    "c8": "^11.0.0",
    "eslint": "^9.39.3",
    "mocha": "^11.7.5",
    "neostandard": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "banking",
    "bank account",
    "sorting code",
    "clearing number",
    "clearingnummer",
    "konto",
    "bankkonto",
    "format",
    "verify"
  ]
}
