{
  "compilerOptions": {
    "target": "es2025",
    "module": "node16",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "es2025"
    ],
    "skipLibCheck": true,
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
